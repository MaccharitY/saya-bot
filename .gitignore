# ---- 密钥：永不提交 ----
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials.*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---- 运行时数据：记忆库、日志、缓存 ----
data/
logs/
*.log
*.db
*.sqlite
*.sqlite3
project_main/data/
project_main/logs/

# ---- 下载的图片/媒体素材（体积大、可重下） ----
project_main/media/
pre/requirement/tmp/

# ---- 抓下来的第三方文本语料 ----
# 剧情全文是别人的作品，且由脚本可重复生成，所以落盘保留、不进这个公开仓库。
# 人格正文（saya.md / saya-lore.md）是**我们写的**，不在此列，照常进仓库。
project_main/persona/corpus/

# 项目所有者提供的 Arcaea 剧情原件与 B 站专栏抓取件。
# 同样是第三方作品，且是原始素材而非产出 —— 本地留好，不进公开仓库。
# 来源与结构见 docs/05-progress-brief.md 第 9 节。
stories/

# ---- 模型权重（几 MB 到几百 MB，可重下） ----
*.pt
*.pth
*.onnx
runs/

# ---- 实验产出的中间文件 ----
pre/experiments/testset/images/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
~$*

# ---- 注意 ----
# pre/requirement/ 里是**课程原始截图（投屏照片）**，含 TA 邮箱等第三方信息，
# **不适合放在公开仓库**。原件仍然保留在本地（不可再生），但不进 git。
# 要求内容已提取进 pre/00-course-requirements.md，日常查那个就够。
pre/requirement/*.jpg
pre/requirement/*.png

# ---- 本机工具设置 ----
# Claude 桌面端会往这里写本机授权记录，因人而异，不该进仓库。
.claude/settings.local.json

# ---- 外部基准的数据本体 ----
# PerceptionBench 单个 JSONL 1.6 GB（图是 base64 内嵌的），绝不能进仓库。
# manifest 仍然提交 —— 它只有题目与答案，几万字。
pre/experiments/testset/*.jsonl

# ---- 真实群聊图集：只留聚合结果与标注表 ----
# 原始图来自真实群聊，可能含个人信息；仓库里只提交哈希 ID 与统计。
pre/experiments/chat-real/images/

# ---- 所有者提供的真实群聊图集（含个人信息，绝不入库） ----
pre/experiments/testset/qqtestimg/

# 真实工况实验：原始结果可能含图内文字，只提交聚合分析
pre/experiments/chat-real/results*.jsonl
pre/experiments/chat-real/annotated/
pre/experiments/chat-real/labels.html

# 复制成 .env 再填真实值。.env 已被 gitignore，永远不要提交。
# 这个文件只放"键名和说明"，任何真实密钥都不许写在这里。

# ---- 模型接入 ----
# DeepSeek 官方。OpenAI 兼容端点（官方另有 Anthropic 兼容端点 .../anthropic）
SAYA_LLM_BASE_URL=https://api.deepseek.com
SAYA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 官方模型名就是 deepseek-flash（DeepSeek-V4.1-Flash 是“版本名”，别填版本名）
# ⚠️ deepseek-v4-pro 不支持图像理解，别切过去
SAYA_LLM_MODEL=deepseek-flash

# ---- 多模态 ----
# ⚠️ 没有单独的「视觉模型」配置：v41f 本身多模态，看图与聊天用**同一个模型**。
#    这正是路线 A/B/C 对比成立的前提（同一个大脑，只比架构不比模型）。
SAYA_VISION_ENABLE=true

# ---- 接入后端 ----
# mock = 本地假事件（开发/测试用）；onebot11_http = 真 QQ（NapCat 的 HTTP 模式）
SAYA_ADAPTER=mock

# ① 我们的事件服务器：NapCat 往这里 POST 事件。把它填进 NapCat 的「HTTP 上报」
SAYA_ONEBOT_LISTEN_HOST=127.0.0.1
SAYA_ONEBOT_LISTEN_PORT=8080
SAYA_ONEBOT_EVENT_PATH=/onebot

# ② NapCat 的 HTTP API：我们调它发消息
SAYA_ONEBOT_API_BASE=http://127.0.0.1:3000

# 上报鉴权（和 NapCat 里设的 token 保持一致；留空则不校验）
SAYA_ONEBOT_ACCESS_TOKEN=

# 机器人自己的 QQ 号（用于判定「@我」；留空则从事件的 self_id 推）
SAYA_SELF_ID=

# ⚠️ NapCat 跑在 WSL/虚拟机里时：上面的 LISTEN_HOST 要改成 0.0.0.0，
#    API_BASE 要填宿主 IP，否则两边连不上。

# ---- 行为开关 ----
# 对话温度：越高越随机。report 的对照实验要求固定温度。
SAYA_TEMPERATURE=0.8
# 看图温度：压低以减少编造（事实描述任务）
SAYA_VISION_TEMPERATURE=0.2

# ---- 思考模式（推理强度）----
# 官方取值：none 关闭思考；low / high / max 开启思考。**官方默认即 high。**
# ⚠️⚠️ 开着思考模式时 **temperature 会被服务端无视** —— 参数照样发出去，
#      但服务端根本不看。也就是说：**做温度对照实验前，必须先把它设成 none**，
#      否则"我们控制了温度"这句话是假的。（实验执行器会把当前值写进结果文件。）
# ⚠️ 思考产生的 token 按**输出**计价（4 元/百万起），延迟也会明显变长 ——
#      群里聊天讲究反应快，觉得慢就把这里改成 none 或 low。
SAYA_REASONING_EFFORT=high

# ---- 每个群怎么对待（核心开关）----
# 格式：群号:策略，逗号分隔。没列出的群用下面的默认策略。
#   silent    不记不回（"这个群当我没在"）
#   mention   记录所有消息，但只在被 @ 时回复   ← 最安全的默认
#   keyword   记录所有消息，命中关键词才回
#   random    记录所有消息，按概率回
#   always    全回（只适合调试，会很吵）
#   selective 选择性插嘴（**尚未实现**，会降级成 mention）
SAYA_GROUP_POLICIES=123456789:mention
SAYA_GROUP_DEFAULT_POLICY=mention

# keyword / random 策略用的参数
SAYA_TRIGGER_KEYWORDS=           # 逗号分隔，例如：saya,咲弥
SAYA_REPLY_PROBABILITY=0.1

# ⚠️ 每分钟最多在同一个群回几条。**填 0 不是"不限制"，是"这个群永远不开口"**
#    （`limit <= 0` 一律判定为已限流，有测试钉着）。
#    想让它闭嘴请用 SAYA_GROUP_POLICIES 里的 silent，别用这个。
SAYA_RATE_LIMIT_PER_GROUP_PER_MIN=5

# ---- 谁能私聊它（结构性防注入，强烈建议配）----
# 私聊是陌生人能直接对机器人下指令的地方；不配的话**任何人的私聊都被忽略**。
SAYA_OWNER_ID=                   # 主人，1 个
SAYA_ADMIN_IDS=                  # 管理，最多 3 个，逗号分隔
SAYA_FRIEND_ALLOWLIST=           # 特别白名单，最多 15 个，逗号分隔

# ---- 埋点（pre 实验数据来源，别关） ----
SAYA_TRACE_ENABLED=true
SAYA_TRACE_PATH=./logs/trace.jsonl

# ---- 数据目录（图片缓存、记忆库） ----
SAYA_DATA_DIR=./data

# ---- 记忆 ----
# 关掉的话它就彻底不记事（也不统计活跃度）。默认开。
SAYA_MEMORY_ENABLED=true

# ---- 长期记忆（独立于会话记忆的那一本）----
# 主人/管理员说「记住…」时，单独记一本，**不参与裁剪**。
# 会话记忆满了会删旧的，这本不会 —— 交代过的事被自动删掉比记不住更糟。
SAYA_NOTEBOOK_ENABLED=true

# ---- 人格 ----
# 人格正文从文件读，换角色不用改代码。相对路径按 project_main/ 解析。
# 文件不存在时会退回内置的占位人格（机器人照样能跑，只是没有人格）。
SAYA_PERSONA_FILE=./persona/saya.md
SAYA_PERSONA_NAME=咲弥

# ---- DNS 缓存（秒）----
# 本机 WSL 的域名解析曾被香港代理拖到 10 秒（见 docs/04 坑三）。
# 缓存能在 TTL 内只解析一次。**这只是兜底，根治要修 DNS**（关代理或给代理加直连规则）。
# 设 0 关闭。连不上模型时会自动清缓存，所以 TTL 长一点没关系。
SAYA_DNS_CACHE_TTL=1800

# ---- 价格（**必填才能算成本**，去官网抄，单位：元/百万 token）----
# 留 0 则埋点里的 cost 恒为 0，报告的成本对比就做不了
#
# ⚠️ **输入是两档价**，而且差一两个数量级（实测 0.02 与 1~2）。
#    `SAYA_PRICE_IN` 是**缓存未命中**的输入价（也就是官网价目表上"输入"那一行的主价）；
#    `SAYA_PRICE_CACHE_HIT` 是**命中**的价。
#    两个都要填：只填前者会高估成本，只填后者会低估。
#    命中多少由服务端决定，我们只能**如实记录**（`cache_hit_tokens`），
#    所以这两档价是"事后重算成本"用的，不是预测用的。
#
# ⚠️ DeepSeek 还有**峰谷分时**：空闲时段约为高峰的 5 折。
#    跑实验时按当时的时段填一套即可 —— 三条路线跑在同一时段，
#    **路线之间的对比与选哪套价无关**，受影响的只是那个绝对数字。
SAYA_PRICE_IN=0
SAYA_PRICE_OUT=0
SAYA_PRICE_CACHE_HIT=0

# ---- 实验开关：三条视觉路线（见 pre/12-experiment-design.md）----
# direct    = 主模型直接看图（零依赖，随时可用）
# delegated = 图片不进主模型，专用 CV 模型出文字（路线 B）
# hybrid    = 专用 CV 模型画编号框 + 主模型推理（路线 C，即 Set-of-Mark 那套）
SAYA_VISION_ROUTE=direct
SAYA_EXPERIMENT_TAG=baseline

# ---- 附属（专用 CV 模型）----
# 路线 delegated / hybrid 需要它。指向 cv_mcp/server.py，用装了依赖的那个 python 跑。
# 依赖清单见 project_main/cv_mcp/requirements.txt（**别照 docs/03 装，那份列的是旧方案**）。
# 示例（WSL 里的路径）：
#   SAYA_CV_MCP_COMMAND=/home/maccharity/saya-venv/bin/python /mnt/d/Claude/DeepSeek_api/saya_bot/project_main/cv_mcp/server.py
SAYA_CV_MCP_COMMAND=

# 模型权重缓存目录（ultralytics / rapidocr 首次运行会自动下到这里）。
# 不填就用 ~/.cache/saya-cv/。⚠️ 权重有几 MB 到几百 MB，**别放进仓库**（.gitignore 已排除 *.pt）。
SAYA_CV_MODEL_DIR=

# ---- 知识源（接梗 / 萌娘百科 / Arcaea）----
# 开着它就能查梗和来历：模型会自己决定要不要查（function calling）。
# ⚠️ 代价是**每条消息都要多带一份工具说明**（约几百 token），
#    所以哪怕这轮没查，输入 token 也会比关着时多一些。嫌贵就设 false。
SAYA_WIKI_ENABLE=true

# 在线查询走萌娘百科的 MediaWiki API（不解析网页，页面改版也不会失效）。
# ⚠️ 萌娘百科禁用了全文搜索接口，只能用「前缀模糊匹配」找条目 —— 关键词对不上就是找不到。
SAYA_WIKI_MOEGIRL_API=https://zh.moegirl.org.cn/api.php

# ⚠️ Arcaea 自己的中文维基（wiki.arcaea.cn）**没有接**：它挂在 Anubis 反爬后面
#    （PoW 挑战页），实测直接拒连。绕过第三方防护是不做的，所以放弃它。
#    好在萌娘百科有完整的 Arcaea 条目（含「咲弥」），够用。

# Arcaea 剧情全文语料的本地目录（切成单章文件 + index.json）。
# 有本地语料时优先查本地：又快又能翻得更深。没有就自动退回在线查。
# 语料来源见 docs/05-progress-brief.md 第 9 节（原件放在 stories/，不进仓库）。
SAYA_ARCAEA_CORPUS_DIR=./persona/corpus

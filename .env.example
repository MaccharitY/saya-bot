# 复制成 .env 再填真实值。.env 已被 gitignore，永远不要提交。
# 这个文件只放"键名和说明"，任何真实密钥都不许写在这里。

# ---- 模型接入 ----
# DeepSeek 的 OpenAI 兼容端点
SAYA_LLM_BASE_URL=https://api.deepseek.com
SAYA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAYA_LLM_MODEL=deepseek-chat

# 可选：走本机 CC Switch 代理（127.0.0.1:15721）时用 Anthropic 格式端点，见 ADR-004
# SAYA_LLM_PROTOCOL=anthropic
# SAYA_LLM_BASE_URL=http://127.0.0.1:15721

# ---- 多模态 ----
SAYA_VISION_MODEL=deepseek-vl
SAYA_VISION_ENABLE=true

# ---- 接入后端 ----
# mock = 本地假事件（开发用）; onebot11 = NapCat 等 OneBot v11 实现
SAYA_ADAPTER=mock
SAYA_ONEBOT_WS_URL=ws://127.0.0.1:3001
SAYA_ONEBOT_ACCESS_TOKEN=

# ---- 行为开关 ----
SAYA_TRIGGER_MODE=mention        # mention | keyword | random | always（见需求 FR-2）
SAYA_TRIGGER_KEYWORDS=           # 逗号分隔，仅 keyword 模式用，例如：莎夜,在吗
SAYA_GROUP_ALLOWLIST=            # 逗号分隔群号；非空时只服务这些群
SAYA_GROUP_DENYLIST=             # 逗号分隔群号，优先级高于白名单
SAYA_REPLY_PROBABILITY=0.1
SAYA_RATE_LIMIT_PER_GROUP_PER_MIN=5

# ---- 埋点（pre 实验数据来源，别关） ----
SAYA_TRACE_ENABLED=true
SAYA_TRACE_PATH=./logs/trace.jsonl

# ---- 实验开关：两条视觉路线对照（pre 核心，见架构 ADR-005） ----
SAYA_VISION_ROUTE=direct_mllm    # direct_mllm | mcp_tools
SAYA_EXPERIMENT_TAG=baseline

# ---- 知识源（接梗 / 萌娘百科） ----
SAYA_WIKI_BASE_URL=https://zh.moegirl.org.cn/api.php
SAYA_WIKI_ENABLE=false
